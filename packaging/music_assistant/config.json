{
  "name": "Music Assistant — HA-AlarmClock pinned",
  "version": "2.10.12-alarmclock.1",
  "slug": "music_assistant_alarmclock",
  "description": "Pinned Music Assistant 2.10.12 with selected-song, one-shot delayed alarm speech",
  "url": "https://github.com/DaFern/HA-Alarm-Clock",
  "arch": ["amd64", "aarch64"],
  "homeassistant_api": true,
  "hassio_api": true,
  "hassio_role": "manager",
  "discovery": ["music_assistant"],
  "auth_api": true,
  "host_network": true,
  "ingress": true,
  "ingress_port": 8094,
  "audio": true,
  "panel_icon": "mdi:alarm-note",
  "panel_title": "MA AlarmClock",
  "panel_admin": true,
  "apparmor": true,
  "map": ["media:rw", "ssl:ro"],
  "init": false,
  "backup_exclude": ["cache.db", "collage_images/*", ".cache/*", "library.db.backup"],
  "stage": "beta",
  "tmpfs": true,
  "options": {"log_level": "info", "safe_mode": false},
  "schema": {"log_level": "list(debug|info|warning|error)", "safe_mode": "bool"}
}
